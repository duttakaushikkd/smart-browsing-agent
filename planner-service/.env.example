APP_NAME="Smart Browsing Agent Planner"
ENVIRONMENT=local
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
BROWSER_SERVICE_URL=http://browser-service:8080
BROWSER_TIMEOUT_SECONDS=20
REDIS_URL=redis://redis:6379/0
USE_REDIS=false
ALLOWED_DOMAINS=amazon.com,linkedin.com,flipkart.com
BLOCKED_DOMAINS=localhost,127.0.0.1,169.254.169.254
MAX_AGENT_STEPS=20
MAX_TOOL_RETRIES=2
AGENT_STEP_TIMEOUT_SECONDS=60
RATE_LIMIT=60/minute
